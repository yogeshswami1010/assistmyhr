# Root-only shell configuration; install outside the website. Do not commit secrets.
ATS_PATH='/home/assistmyhr.com/public_html/ats'
# If SAAS_STORAGE_ROOT in Laravel points outside ATS_PATH, enter that absolute path.
EXTRA_STORAGE_PATH=''
RESTIC_REPOSITORY='s3:https://YOUR-BUCKET-ENDPOINT.backblazeb2.com/YOUR-BUCKET/assistmyhr'
RESTIC_PASSWORD_FILE='/etc/assistmyhr-backup.password'
AWS_ACCESS_KEY_ID='YOUR-B2-KEY-ID'
AWS_SECRET_ACCESS_KEY='YOUR-B2-APPLICATION-KEY'
