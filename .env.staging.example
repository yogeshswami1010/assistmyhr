APP_NAME="AssistMyHR Staging"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.assistmyhr.com
REDIRECT_HTTPS=true

LOG_CHANNEL=stack
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=atsstage_platform
DB_USERNAME=atsstage_platform
DB_PASSWORD=

SAAS_ENABLED=false
SAAS_DATABASE_PREFIX=atsstage
SAAS_PROVISIONING_USERNAME=atsstage_provision
SAAS_PROVISIONING_PASSWORD=
SAAS_TENANT_DB_USERNAME=atsstage_tenants
SAAS_TENANT_DB_PASSWORD=

SESSION_DRIVER=file
SESSION_COOKIE=assistmyhr_staging_session
SESSION_SECURE_COOKIE=true
CACHE_DRIVER=file
QUEUE_DRIVER=sync
BROADCAST_DRIVER=log
FILESYSTEM_DRIVER=local

MAIL_DRIVER=log
MAIL_FROM_ADDRESS=staging@example.test
MAIL_FROM_NAME="AssistMyHR Staging"

ZOHO_SIGN_TESTING=true
