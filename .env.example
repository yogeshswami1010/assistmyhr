APP_NAME=AssistMyHR
APP_ENV=codecanyon
APP_KEY=base64:k+3EvygIClUO9DZrEWL8lQDSreA0erq0nmjf55JqI5Y=
APP_DEBUG=true
APP_URL=https://recruit.dev
REDIRECT_HTTPS=false

# Recommended for DOC/DOCX resume-to-PDF conversion on production servers.
# LIBREOFFICE_BINARY=/usr/bin/libreoffice

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=recruit
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=array
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_DRIVER=sync

# Enable only after migrating and running saas:install. Never commit real passwords.
SAAS_ENABLED=false
SAAS_DATABASE_PREFIX=assistmyhr
SAAS_PROVISIONING_USERNAME=
SAAS_PROVISIONING_PASSWORD=
SAAS_TENANT_DB_USERNAME=
SAAS_TENANT_DB_PASSWORD=
SESSION_SECURE_COOKIE=true

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_NAME="AssistMyHR"

# AI Search applicant emails (Zoho SMTP)
AI_SEARCH_MAIL_HOST=smtppro.zoho.in
AI_SEARCH_MAIL_PORT=465
AI_SEARCH_MAIL_ENCRYPTION=ssl
AI_SEARCH_MAIL_USERNAME=yogesh@assistmyday.com
AI_SEARCH_MAIL_PASSWORD=
AI_SEARCH_MAIL_FROM_ADDRESS=yogesh@assistmyday.com
AI_SEARCH_MAIL_FROM_NAME="AssistMyHR"

# Optional platform default for Outlook inboxes without client-specific app settings.
# Prefer Super Admin > Clients > Manage > Outlook Inbox to configure each client.
MICROSOFT_REPLY_CLIENT_ID=
MICROSOFT_REPLY_CLIENT_SECRET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Google Calendar read-only integration for Interview Schedule.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Zoho Sign offer letters. See docs/zoho-sign.md.
ZOHO_SIGN_DOMAIN=com
ZOHO_SIGN_CLIENT_ID=
ZOHO_SIGN_CLIENT_SECRET=
ZOHO_SIGN_REFRESH_TOKEN=
ZOHO_SIGN_DEVELOPMENT_TOKEN=
ZOHO_SIGN_WEBHOOK_SECRET=
ZOHO_SIGN_TESTING=false
