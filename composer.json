{
    "name": "laravel/laravel",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.2",
        "barryvdh/laravel-translation-manager": "^0.6.9",
        "cviebrock/eloquent-sluggable": "^12.0",
        "doctrine/dbal": "^4.0",
        "froiden/envato": "^5.2.1",
        "froiden/laravel-installer": "^11.0",
        "froiden/laravel-rest-api": "12.0.99",
        "guzzlehttp/guzzle": "^7.8",
        "intervention/image": "^3.0",
        "laravel/framework": "^12.0",
        "laravel/helpers": "^1.7",
        "laravel/socialite": "^5.16",
        "laravel/tinker": "^2.10",
        "laravel/ui": "^4.6",
        "laravel/vonage-notification-channel": "^3.3",
        "league/flysystem-aws-s3-v3": "^3.29",
        "maatwebsite/excel": "^3.1.64",
        "macellan/laravel-zip": "^1.0",
        "nwidart/laravel-modules": "^12.0",
        "shanmuga/laravel-entrust": "^6.0",
        "simplesoftwareio/simple-qrcode": "^4.2",
        "smalot/pdfparser": "^2.0",
        "tymon/jwt-auth": "^2.3",
        "yajra/laravel-datatables-buttons": "^12.0",
        "yajra/laravel-datatables-html": "^12.0",
        "yajra/laravel-datatables-oracle": "^12.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.15",
        "barryvdh/laravel-ide-helper": "^3.5",
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.24",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5",
        "spatie/laravel-ignition": "^2.9"
    },
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "froiden/laravel-rest-api",
                "version": "12.0.99",
                "dist": {
                    "type": "zip",
                    "url": "https://codeload.github.com/Froiden/laravel-rest-api/zip/refs/heads/master"
                },
                "require": {
                    "php": "^8.2",
                    "laravel/framework": "^12.0"
                },
                "autoload": {
                    "psr-4": {
                        "Froiden\\RestAPI\\": "src/",
                        "Froiden\\RestAPI\\Tests\\": "tests/"
                    }
                },
                "extra": {
                    "laravel": {
                        "providers": [
                            "Froiden\\RestAPI\\Providers\\ApiServiceProvider"
                        ]
                    }
                }
            }
        }
    ],
    "autoload": {
        "classmap": [
            "database/seeds",
            "database/factories"
        ],
        "files": [
            "start.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Modules\\": "Modules/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": ["froiden/envato"]
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "wikimedia/composer-merge-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
